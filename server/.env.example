# Backend (Express). Copy to server/.env
PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/inventory_app

# Must be >= 32 chars in production. Generate one with:  openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_secret

# Idle session lifetime. The browser cookie renews on activity; an idle session
# times out after this. Accepts 45m / 12h / 7d.
JWT_EXPIRES_IN=12h

# Comma-separated list of allowed browser origins.
CLIENT_URL=http://localhost:5173

# --- Deployment (leave unset for local dev) ---
# Hop count for X-Forwarded-For when behind a reverse proxy / load balancer.
# Required for correct rate limiting and Secure cookies in production. e.g. 1
# TRUST_PROXY=1
# Send cookies only over HTTPS (defaults on when NODE_ENV=production).
# SECURE_COOKIES=1
# Cookie SameSite policy: lax (default) | strict | none. Use "none" only with HTTPS
# when the frontend and API are on different sites.
# COOKIE_SAMESITE=lax
# Share the session cookie across subdomains, e.g. .example.com
# COOKIE_DOMAIN=.example.com
